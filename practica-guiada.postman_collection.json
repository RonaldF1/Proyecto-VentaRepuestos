                {
                  "key": "por_pagina",
                  "value": "5"
                }
              ]
            },
            "header": []
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  " pm.response.to.have.status(200);",
                  "});",
                  "pm.test('C2 · Respeta pagina y por_pagina', function () {",
                  " const r = pm.response.json();",
                  " pm.expect(r.meta.pagina).to.eql(2);",
                  " pm.expect(r.meta.por_pagina).to.eql(5);",
                  " pm.expect(r.datos.length).to.be.at.most(5);",
                  "});",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "por_pagina fuera de rango",
