    {
      "name": "03 Contrato",
      "item": [
        {
          "name": "Productos pagina 2",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/productos?pagina=2&por_pagina=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos"
              ],
              "query": [
                {
                  "key": "pagina",
                  "value": "2"
