    {
      "name": "02 Tienda",
      "item": [
        {
          "name": "Listar productos Sin credenciales",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{tienda_url}}/wp-json/wc/v3/products?per_page=5&page=1",
              "host": [
                "{{tienda_url}}"
              ],
              "path": [
                "wp-json",
                "wc",
                "v3",
                "products"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "5"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "header": [],
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', function () {\r",
                  "       pm.response.to.have.status(401);\r",
                  "      });\r",
                  "      pm.test('El código dice que no puede ver', function () {\r",
                  "       const codigo = pm.response.json().code;\r",
                  "       pm.expect(codigo).to.eql('woocommerce_rest_cannot_view');\r",
                  "      });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{tienda_url}}/wp-json/wc/v3/products?per_page=5&page=1",
              "host": [
                "{{tienda_url}}"
              ],
              "path": [
                "wp-json",
                "wc",
                "v3",
                "products"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "5"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "header": []
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const productos = pm.response.json();\r",
                  "      pm.environment.set('producto_id', productos[0].id);\r",
                  "      pm.test('Responde 200', function () {\r",
                  "       pm.response.to.have.status(200);\r",
                  "      });\r",
                  "      pm.test('Trae la cabecera X-WP-TotalPages', function () {\r",
                  "       pm.response.to.have.header('X-WP-TotalPages');\r",
                  "      });\r",
                  "      pm.test('Devuelve como máximo 5 productos', function () {\r",
                  "       pm.expect(pm.response.json().length).to.be.at.most(5);\r",
                  "      });\r",
                  "      pm.test('Responde en menos de 3 s', function () {\r",
                  "       pm.expect(pm.response.responseTime).to.be.below(3000);\r",
                  "      });\r",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener un producto",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{tienda_url}}/wp-json/wc/v3/products/{{producto_id}}",
              "host": [
                "{{tienda_url}}"
              ],
              "path": [
                "wp-json",
                "wc",
                "v3",
                "products",
                "{{producto_id}}"
              ]
            },
            "header": []
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const esquemaProducto = {\r",
                  "       type: 'object',\r",
                  "       required: ['id', 'name', 'sku', 'price', 'stock_quantity'],\r",
                  "       properties: {\r",
                  "       id: { type: 'integer' },\r",
                  "       name: { type: 'string' },\r",
                  "       sku: { type: 'string' },\r",
                  "       price: { type: 'string' },\r",
                  "       stock_quantity: { type: ['integer', 'null'] }\r",
                  "       }\r",
                  "      };\r",
                  "      pm.test('Cumple el esquema del producto', function () {\r",
                  "       pm.response.to.have.jsonSchema(esquemaProducto);\r",
                  "      });\r",
                  "      pm.test('Trae el campo propio del plugin', function () {\r",
                  "       const campo = pm.environment.get('campo_propio');\r",
                  "       pm.expect(pm.response.json()).to.have.property(campo);\r",
                  "      });"
                ]
              }
            }
          ]
        },
