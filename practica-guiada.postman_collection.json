              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 422', function () {",
                  " pm.response.to.have.status(422);",
                  "});",
                  "pm.test('C3 · error.codigo es validacion', function () {",
                  " pm.expect(pm.response.json().error.codigo).to.eql('validacion');",
                  "});",
