        ]
      }
    },
    "/wp-json/wc/v3/products/{producto_id}": {
      "get": {
        "summary": "Obtener un producto",
        "responses": {},
        "tags": [
          "02 Tienda"
        ]
      },
      "parameters": [
        {
          "name": "producto_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "{{producto_id}}"
        }
      ]
    },
